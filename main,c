#include <stdio.h>

void sort(int a[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int min_index = i;
        for (int j = i + 1; j < n; j++)
            if (a[j] < a[min_index]) min_index = j;
        int t = a[i];
        a[i] = a[min_index];
        a[min_index] = t;
    }
}

int main(void) {
    int a[] = {4, -2, 7, 4, 0};
    sort(a, 5);
    for (int i = 0; i < 5; i++) printf("%d ", a[i]);
    putchar('\n');
    return 0;
}
